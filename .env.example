# Firebase web app config
# Find it in the Firebase console: Project settings > Your apps > Web app.
# Copy the keys into a real .env file (gitignored). The public site only needs
# the read key; admin writes go through Firebase Auth (email/password).
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=