# Firebase Configuration for Addisalem Film Academy
# Copy this file to .env and fill in your Firebase Web App credentials

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# EmailJS (free enrollment-notification emails — https://www.emailjs.com)
# Get these from your EmailJS dashboard:
#   Service ID  -> Email Services -> your service (the long id)
#   Template ID -> Email Templates -> your template
#   Public key  -> Account -> API Keys -> Public Key
VITE_EMAILJS_SERVICE_ID=
VITE_EMAILJS_TEMPLATE_ID=
VITE_EMAILJS_PUBLIC_KEY=

# Optional admin allowlist (comma-separated emails). A signed-in user is treated
# as an admin if their email matches here OR their Firestore `users/{uid}` doc
# has role: "admin".
VITE_ADMIN_EMAILS=
