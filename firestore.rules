rules_version = '2';

// Firestore security rules for Adddisalem Film Training Center.
// Keep these in sync with the rules deployed in the Firebase console
// (Firebase Console -> Firestore Database -> Rules tab).

service cloud.firestore {
  match /databases/{database}/documents {

    // Visitors read announcements; only signed-in admins write them.
    match /announcements/{doc} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // The public contact form may only create leads.
    // Admins (signed in at /admin) can read and delete them.
    match /leads/{doc} {
      allow create: if true;
      allow read, delete: if request.auth != null;
    }
  }
}